<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>Daily Briefing · Archive</title>
<style>{% include "style.css" %}</style>
</head>
<body>
<main>
  <p class="kicker">Daily Briefing</p>
  <h1>Archive</h1>
  <ul class="archive">
